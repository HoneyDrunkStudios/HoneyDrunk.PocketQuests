{
  "name": "pocket-quests-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@honeydrunk/ui-native": "0.1.0",
    "@honeydrunk/ui-tokens": "0.1.0",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.3.0",
    "c8": "12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jsdom": "30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint && eslint scripts",
    "check:architecture": "node --test tests/tooling/architecture.test.mjs && eslint src --max-warnings 0",
    "test:logic": "node scripts/test-ci.cjs",
    "test:ci": "node scripts/test-ci.cjs",
    "check:ui": "node scripts/ui-snapshot.cjs",
    "pretypecheck": "npm run check:ui",
    "postinstall": "node scripts/patch-dependencies.cjs",
    "check:security-patch": "node scripts/patch-dependencies.cjs --check",
    "audit:security": "npm audit --audit-level=moderate",
    "generate:api": "node scripts/generate-api.cjs",
    "check:api": "node scripts/generate-api.cjs --check",
    "eas-build-post-install": "npm run audit:security",
    "test:coverage": "c8 --config .c8rc.json node --enable-source-maps scripts/test-ci.cjs"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "workspaces": [
    "packages/*"
  ]
}
