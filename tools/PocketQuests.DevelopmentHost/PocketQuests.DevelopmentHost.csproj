<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UserSecretsId>pocketquests-expo-go-development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.5.96" />
    <ProjectReference Include="../../src/PocketQuests.Api/PocketQuests.Api.csproj" />
    <ProjectReference Include="$(IdentityProjectsRoot)/HoneyDrunk.Identity.Api/HoneyDrunk.Identity.Api.csproj" />
    <ProjectReference Include="../../src/PocketQuests.Database/PocketQuests.Database.sqlproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(IdentityProjectsRoot)/HoneyDrunk.Identity.Database/HoneyDrunk.Identity.Database.sqlproj" ReferenceOutputAssembly="false" />
    <None Include="../../src/PocketQuests.Database/bin/$(Configuration)/PocketQuests.Database.dacpac" Link="PocketQuests.Database.dacpac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/PocketQuests.Database/bin/$(Configuration)/master.dacpac" Link="master.dacpac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(IdentityProjectsRoot)/HoneyDrunk.Identity.Database/bin/$(Configuration)/HoneyDrunk.Identity.Database.dacpac" Link="HoneyDrunk.Identity.Database.dacpac" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireIdentitySource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UseIdentitySource)' != 'true' or '$(IdentitySourceRoot)' == ''" Text="The development host requires the local Identity source checkout. Run Initialize-Local.ps1 first." />
  </Target>
</Project>
