<Project Sdk="Microsoft.NET.Sdk">

<ItemGroup>
    <PackageReference Include="HoneyDrunk.Audit.Data" Version="0.3.0" />
    <PackageReference Include="HoneyDrunk.Data.EntityFramework" Version="0.8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!-- SqlClient 7 separates Entra authentication from the core driver. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.2" />
    <!-- Match net11 so the patched PKCS asset wins over the ASP.NET shared framework. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HoneyDrunk.Data.Outbox" Version="0.8.0" />
  </ItemGroup>
</Project>
