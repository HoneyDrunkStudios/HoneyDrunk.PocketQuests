<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../PocketQuests.Services/PocketQuests.Services.csproj" />
    <ProjectReference Include="..\PocketQuests.Domain\PocketQuests.Domain.csproj" />
    <ProjectReference Include="..\PocketQuests.Data\PocketQuests.Data.csproj" />
    <ProjectReference Include="..\PocketQuests.ServiceDefaults\PocketQuests.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="HoneyDrunk.Payments.Stripe" Version="0.1.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="11.0.0" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>be26a4e2-e7bf-4a13-90b9-86be79a088f4</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot/admin/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseIdentitySource)' != 'true'">
    <PackageReference Include="HoneyDrunk.Identity.Client" Version="[$(IdentityClientVersion)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseIdentitySource)' == 'true'">
    <ProjectReference Include="$(IdentityProjectsRoot)/HoneyDrunk.Identity.Client/HoneyDrunk.Identity.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HoneyDrunk.Data.Outbox.Dispatcher" Version="0.8.0" />
    <PackageReference Include="HoneyDrunk.Transport.AzureServiceBus" Version="0.8.0" />
  </ItemGroup>
  <ItemGroup>
    <_AdminFrontendInput Include="../../apps/admin/src/**/*;../../apps/admin/*.json;../../apps/admin/*.ts;../../apps/admin/index.html" />
  </ItemGroup>
  <!-- Build before static-asset discovery, including the first clean checkout.
       Re-add Content so newly generated hashed assets participate in publish. -->
  <Target Name="BuildAdminFrontend" Inputs="@(_AdminFrontendInput)" Outputs="$(MSBuildProjectDirectory)/wwwroot/admin/index.html">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../../apps/admin" Command="npm ci --ignore-scripts" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../../apps/admin" Command="npm run build" />
  </Target>
  <Target Name="IncludeAdminFrontend" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BuildAdminFrontend">
    <ItemGroup>
      <Content Remove="wwwroot/admin/**/*" />
      <Content Include="wwwroot/admin/**/*" />
    </ItemGroup>
  </Target>
</Project>
