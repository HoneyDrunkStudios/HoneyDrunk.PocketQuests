<Project>
  <Import Project="$(MSBuildThisFileDirectory).local/Identity.props" Condition="Exists('$(MSBuildThisFileDirectory).local/Identity.props')" />
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IdentityClientVersion>0.1.0-alpha.4</IdentityClientVersion>
    <UseIdentitySource Condition="'$(UseIdentitySource)' == ''">false</UseIdentitySource>
    <NuGetLockFilePath Condition="'$(UseIdentitySource)' == 'true'">$(MSBuildProjectDirectory)/.local/packages.source.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HoneyDrunk.Standards" Version="0.3.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
