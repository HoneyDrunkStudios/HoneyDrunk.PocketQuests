<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PocketQuests.Data/PocketQuests.Data.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseIdentitySource)' != 'true'">
    <PackageReference Include="HoneyDrunk.Identity.Abstractions" Version="[$(IdentityClientVersion)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseIdentitySource)' == 'true'">
    <ProjectReference Include="$(IdentitySourceRoot)/HoneyDrunk.Identity/HoneyDrunk.Identity.Abstractions/HoneyDrunk.Identity.Abstractions.csproj" />
  </ItemGroup>
</Project>
