<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Visual Studio loads the original SSDT project system. Only dotnet/CI uses the SQL SDK. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
    <BaseIntermediateOutputPath Condition="'$(MSBuildRuntimeType)' == 'Core'">obj\dotnet\</BaseIntermediateOutputPath>
    <BaseIntermediateOutputPath Condition="'$(MSBuildRuntimeType)' != 'Core'">obj\ssdt\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.Build.Sql" Version="2.3.0" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <PropertyGroup>
    <Name>PocketQuests.Database</Name>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>4.1</ProjectVersion>
    <ProjectGuid>{1696454c-d77a-477a-b7d2-83fbc8473cc4}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql150DatabaseSchemaProvider</DSP>
    <OutputType>Database</OutputType>
    <RootNamespace>PocketQuests.Database</RootNamespace>
    <AssemblyName>PocketQuests.Database</AssemblyName>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>
    <DeployToDatabase>True</DeployToDatabase>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <BuildScriptName>$(MSBuildProjectName).sql</BuildScriptName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SqlServerVerification>False</SqlServerVerification>
    <IncludeCompositeObjects>True</IncludeCompositeObjects>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildRuntimeType)' != 'Core'">
    <!-- Framework is used by SSDT build tools, never by the deployed SQL database or APIs. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <TargetLanguage>CS</TargetLanguage>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">18.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Resolve system procedure signatures; never deploy master objects into the product. -->
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.Master" Version="150.1.2" Condition="'$(MSBuildRuntimeType)' == 'Core'">
      <DatabaseVariableLiteralValue>master</DatabaseVariableLiteralValue>
      <SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
    </PackageReference>
    <ArtifactReference Include="$(SQLDBExtensionsRefPath)\Extensions\SqlServer\150\SQLSchemas\master.dacpac" Condition="'$(MSBuildRuntimeType)' != 'Core'">
      <DatabaseVariableLiteralValue>master</DatabaseVariableLiteralValue>
      <SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
    </ArtifactReference>
    <Folder Include="Tables" />
    <Folder Include="Schemas" />
    <Folder Include="Data" />
    <Folder Include="Data\Seed" />
    <Folder Include="Data\AdHoc" />
    <Folder Include="PublishProfiles" />
