<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Visual Studio loads the original SSDT project system. Only dotnet/CI uses the SQL SDK. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
    <BaseIntermediateOutputPath Condition="'$(MSBuildRuntimeType)' == 'Core'">obj\dotnet\</BaseIntermediateOutputPath>
    <BaseIntermediateOutputPath Condition="'$(MSBuildRuntimeType)' != 'Core'">obj\ssdt\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.Build.Sql" Version="2.3.0" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <PropertyGroup>
    <Name>PocketQuests.Database</Name>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>4.1</ProjectVersion>
    <ProjectGuid>{1696454c-d77a-477a-b7d2-83fbc8473cc4}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql150DatabaseSchemaProvider</DSP>
    <OutputType>Database</OutputType>
    <RootNamespace>PocketQuests.Database</RootNamespace>
    <AssemblyName>PocketQuests.Database</AssemblyName>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>
    <DeployToDatabase>True</DeployToDatabase>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <BuildScriptName>$(MSBuildProjectName).sql</BuildScriptName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SqlServerVerification>False</SqlServerVerification>
    <IncludeCompositeObjects>True</IncludeCompositeObjects>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildRuntimeType)' != 'Core'">
    <!-- Framework is used by SSDT build tools, never by the deployed SQL database or APIs. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <TargetLanguage>CS</TargetLanguage>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">18.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Resolve system procedure signatures; never deploy master objects into the product. -->
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.Master" Version="150.1.2" Condition="'$(MSBuildRuntimeType)' == 'Core'">
      <DatabaseVariableLiteralValue>master</DatabaseVariableLiteralValue>
      <SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
    </PackageReference>
    <ArtifactReference Include="$(SQLDBExtensionsRefPath)\Extensions\SqlServer\150\SQLSchemas\master.dacpac" Condition="'$(MSBuildRuntimeType)' != 'Core'">
      <DatabaseVariableLiteralValue>master</DatabaseVariableLiteralValue>
      <SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
    </ArtifactReference>
    <Folder Include="Tables" />
    <Folder Include="Schemas" />
    <Folder Include="Data" />
    <Folder Include="Data\Seed" />
    <Folder Include="Data\AdHoc" />
    <Folder Include="PublishProfiles" />
    <Build Include="Security\pocketquests.Runtime.sql" />
    <Build Include="Schemas\outbox.sql" />
    <Build Include="Schemas\pocketquests.sql" />
    <Build Include="Tables\Categories\Category.sql" />
    <Build Include="Tables\Attributes\Attribute.sql" />
    <Build Include="Tables\Skills\Skill.sql" />
    <Build Include="Tables\Progress\ProfileReward.sql" />
    <Build Include="Tables\Quests\SystemQuest.sql" />
    <Build Include="Tables\Quests\QuestCommandHistory.sql" />
    <Build Include="Tables\Quests\QuestCommandInterest.sql" />
    <Build Include="Tables\Accounts\Account.sql" />
    <Build Include="Tables\Synchronization\CommandReceipt.sql" />
    <Build Include="Tables\Accounts\AccountInterest.sql" />
    <Build Include="Tables\Accounts\AccountPause.sql" />
    <Build Include="Tables\Accounts\TimeZoneChange.sql" />
    <Build Include="Tables\Skills\CustomSkill.sql" />
    <Build Include="Tables\Skills\SkillAssessment.sql" />
    <Build Include="Tables\Quests\QuestDefinition.sql" />
    <Build Include="Tables\Quests\QuestDefinitionRevision.sql" />
    <Build Include="Tables\Quests\QuestDefinitionAttributeAllocation.sql" />
    <Build Include="Tables\Quests\QuestDefinitionSkillAllocation.sql" />
    <Build Include="Tables\Quests\QuestSeries.sql" />
    <Build Include="Tables\Quests\QuestSeriesRevision.sql" />
    <Build Include="Tables\Synchronization\SyncAnchor.sql" />
    <Build Include="Tables\Quests\QuestOccurrence.sql" />
    <Build Include="Tables\Quests\QuestOccurrenceRevision.sql" />
    <Build Include="Tables\Quests\QuestOccurrenceEvent.sql" />
    <Build Include="Tables\Quests\QuestCompletion.sql" />
    <Build Include="Tables\Progress\XpLedgerEntry.sql" />
    <Build Include="Tables\Progress\XpBalance.sql" />
    <Build Include="Tables\Categories\CategoryProgress.sql" />
    <Build Include="Tables\Progress\AccountEntitlement.sql" />
    <Build Include="Tables\Lifecycle\AccountLifecycleState.sql" />
    <Build Include="Tables\Lifecycle\ErasureMarker.sql" />
    <Build Include="Tables\Lifecycle\LifecycleMessage.sql" />
    <Build Include="Tables\Accounts\AccountAuditRecord.sql" />
    <Build Include="Tables\dbo\AuditRecords.sql" />
    <Build Include="Tables\outbox\OutboxMessages.sql" />
    <None Include="Data\AdHoc\README.md" />
    <PostDeploy Include="Data\PostDeployment.sql" />
    <None Include="Data\Seed\README.md" />
    <None Include="Data\Seed\PocketQuestsCatalog.sql" />
    <None Include="PublishProfiles\Local.publish.xml" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.Build.Sql" Version="2.3.0" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <Import Project="$(SQLDBExtensionsRefPath)\Microsoft.Data.Tools.Schema.SqlTasks.targets" Condition="'$(MSBuildRuntimeType)' != 'Core' AND '$(SQLDBExtensionsRefPath)' != ''" />
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\SSDT\Microsoft.Data.Tools.Schema.SqlTasks.targets" Condition="'$(MSBuildRuntimeType)' != 'Core' AND '$(SQLDBExtensionsRefPath)' == ''" />
</Project>
