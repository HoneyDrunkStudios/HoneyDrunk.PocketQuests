<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.5.96" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="../PocketQuests.Data/PocketQuests.Data.csproj" />
    <ProjectReference Include="../PocketQuests.Api/PocketQuests.Api.csproj" />
    <ProjectReference Include="../PocketQuests.Database/PocketQuests.Database.sqlproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../PocketQuests.ReplayProbe/PocketQuests.ReplayProbe.csproj" ReferenceOutputAssembly="false" />
    <None Include="../PocketQuests.Database/bin/$(Configuration)/PocketQuests.Database.dacpac" Link="PocketQuests.Database.dacpac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../PocketQuests.Database/bin/$(Configuration)/master.dacpac" Link="master.dacpac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/schema/schema-contract.json" Link="schema-contract.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../scripts/schema/*.sql" Link="Sql/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Reuse the existing numerical/history regressions in this package-mode lane;
         these tests reference Domain only and require no Identity API source build. -->
    <!-- Same product SQL/API cases in both hosts; source-only Identity acceptance stays separate. -->
    <Compile Include="../PocketQuests.Tests/Integration/*.cs" Exclude="../PocketQuests.Tests/Integration/SqlApiTests.IdentityHost.cs;../PocketQuests.Tests/Integration/LifecycleSqlTests.cs;../PocketQuests.Tests/Integration/BrowserFixture.cs" Link="ProductRegression/%(Filename)%(Extension)" />
    <Compile Include="../PocketQuests.Tests/Fixtures/TestQuestWorkflow.cs" Link="ProductRegression/TestQuestWorkflow.cs" />
    <Compile Include="../PocketQuests.Tests/Fixtures/PersistenceServices.cs" Link="ProductRegression/PersistenceServices.cs" />
    <Compile Include="../PocketQuests.Tests/Fixtures/ProductDatabase.cs" Link="ProductRegression/ProductDatabase.cs" />
    <Compile Include="../PocketQuests.Tests/Api/*.cs" Link="ApiRegression/%(Filename)%(Extension)" />
    <Compile Include="../PocketQuests.Tests/Unit/*.cs" Link="DomainRegression/%(Filename)%(Extension)" />
    <Compile Include="../PocketQuests.Tests/AccountLifecycle/LifecycleMessagingTests.cs" Link="MessagingRegression/LifecycleMessagingTests.cs" />
  </ItemGroup>
  <Target Name="CopyReplayProbe" AfterTargets="Build">
    <ItemGroup>
      <ReplayProbeFile Include="../PocketQuests.ReplayProbe/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReplayProbeFile)" DestinationFiles="@(ReplayProbeFile->'$(OutputPath)ReplayProbe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
