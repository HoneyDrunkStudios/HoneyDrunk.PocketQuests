<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PocketQuests.Domain\PocketQuests.Domain.csproj" />
    <ProjectReference Include="..\PocketQuests.Api\PocketQuests.Api.csproj" />
    <ProjectReference Include="$(IdentitySourceRoot)/HoneyDrunk.Identity/HoneyDrunk.Identity.Api/HoneyDrunk.Identity.Api.csproj" Condition="'$(IdentitySourceRoot)' != ''" />
  </ItemGroup>
  <Target Name="RequireIdentityIntegrationSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(IdentitySourceRoot)' == ''" Text="SQL integration tests require Identity source. Run scripts/Initialize-Local.ps1 -IdentitySourceRoot PATH first." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.5.96" />
    <ProjectReference Include="../PocketQuests.Database/PocketQuests.Database.sqlproj" ReferenceOutputAssembly="false" />
    <None Include="../PocketQuests.Database/bin/$(Configuration)/PocketQuests.Database.dacpac" Link="PocketQuests.Database.dacpac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../PocketQuests.Database/bin/$(Configuration)/master.dacpac" Link="master.dacpac" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(IdentitySourceRoot)/HoneyDrunk.Identity/HoneyDrunk.Identity.Database/HoneyDrunk.Identity.Database.sqlproj" ReferenceOutputAssembly="false" />
    <None Include="$(IdentitySourceRoot)/HoneyDrunk.Identity/HoneyDrunk.Identity.Database/bin/$(Configuration)/HoneyDrunk.Identity.Database.dacpac" Link="HoneyDrunk.Identity.Database.dacpac" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
