<Project Sdk="Microsoft.NET.Sdk">

<ItemGroup>
    <PackageReference Include="HoneyDrunk.Audit.Data" Version="0.2.1" />
    <PackageReference Include="HoneyDrunk.Data.EntityFramework" Version="0.7.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Match net10 so the patched PKCS asset wins over the ASP.NET shared framework. -->
